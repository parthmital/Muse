# =============================================================================
# Muse Backend — environment variables
# =============================================================================
# Copy to `.env` and fill in real values where noted. Every variable below is
# read by Backend/src/config.ts. Values shown are the in-code defaults; you only
# need to set the ones marked REQUIRED or those you wish to override.
# =============================================================================

# ── Core / server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
LOG_LEVEL=info

# Single-user dev mode identity used by endpoints that don't yet carry an
# authenticated user.
DEV_USER_ID=dev-user-001

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Relative paths are resolved against the
# process CWD. The runtime PrismaClient uses this via the better-sqlite3 adapter
# (file:<resolved SQLITE_PATH>), so this is the source of truth at runtime.
SQLITE_PATH=./data/music_rec.db

# Optional. Only consulted by Prisma CLI tooling (e.g. `prisma db push` /
# `prisma studio`) when a datasource URL is required. The application runtime
# does NOT need this — it derives the URL from SQLITE_PATH. Keep it in sync.
# DATABASE_URL=file:./data/music_rec.db

# ── External services ────────────────────────────────────────────────────────
# Hi-Fi streaming API (the hifi-api FastAPI service).
HIFI_API_BASE_URL=
HIFI_API_KEY=                       # REQUIRED if HIFI_API_BASE_URL is set — placeholder

# Tidal-compatible metadata/lookup API base URL. In docker-compose this points
# at the hifi-api service (http://hifi-api:8000).
TIDAL_API_BASE_URL=http://localhost:4000

# Last.fm API key — REQUIRED for recommendations/enrichment. Placeholder value.
LASTFM_API_KEY=your_lastfm_api_key_here

# MusicBrainz User-Agent application string (per MB API etiquette).
MUSICBRAINZ_APP=MusicRecEngine/1.0

# ── Recommendation / mix sizing ──────────────────────────────────────────────
QUEUE_SIZE=25
HOME_REC_COUNT=20
MIX_TRACK_COUNT=30
RECENCY_DECAY_DAYS=30

# ── Caching (milliseconds) ───────────────────────────────────────────────────
CACHE_PROFILE_TTL_MS=300000
CACHE_REC_TTL_MS=120000

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_MS=500
WORKER_CONCURRENCY=4

# ── Job queue ────────────────────────────────────────────────────────────────
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SEC=60
JOB_LEASE_SEC=300
JOB_CLEANUP_INTERVAL_MS=3600000
LASTFM_CACHE_GRACE_DAYS=30
SHELF_IMPRESSION_RETENTION_DAYS=90

# ── Playback queue ───────────────────────────────────────────────────────────
QUEUE_LOW_WATER_MARK=5
SESSION_TTL_MS=10800000
PLAYED_IDS_HISTORY_CAP=200
HIGH_SIGNAL_COMPLETION_RATIO=0.8

# ── Recommender tuning ───────────────────────────────────────────────────────
SEED_TRACK_CAP=8
SEED_ARTIST_CAP=4
SIMILAR_PER_TRACK=30
MAX_TIDAL_LOOKUPS=44
TIDAL_RESOLVE_BATCH=5
PROFILE_MAX_GENRES=20
PROFILE_INTERACTION_LIMIT=5000

# ── Homepage builder ─────────────────────────────────────────────────────────
SECTION_ITEM_COUNT=10
COLLECTION_TRACK_COUNT=50
HOMEPAGE_FRESH_SEC=21600
TRACK_POOL_SIZE=180
