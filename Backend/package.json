{
	"name": "music-rec-engine",
	"version": "3.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"worker": "tsx watch src/workers/runner.ts",
		"start": "node dist/index.js",
		"build": "prisma generate && tsc",
		"predev": "prisma db push",
		"db:push": "prisma db push",
		"db:generate": "prisma generate",
		"db:studio": "prisma studio",
		"regen:mixes": "tsx src/scripts/regenerateSystemMixes.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "^9.0.1",
		"@fastify/swagger": "^8.14.0",
		"@fastify/swagger-ui": "^4.0.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"axios": "^1.7.2",
		"dotenv": "^16.4.5",
		"fast-average-color": "^9.5.0",
		"fastify": "^4.27.0",
		"fastq": "^1.17.1",
		"jimp": "^1.6.0",
		"lru-cache": "^10.2.2",
		"node-vibrant": "^3.1.6",
		"p-limit": "^5.0.0",
		"pg": "^8.13.1",
		"pino": "^9.2.0",
		"pino-pretty": "^11.2.0",
		"prisma": "^7.8.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^20.14.2",
		"@types/pg": "^8.11.10",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"tsx": "^4.15.7",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	}
}
