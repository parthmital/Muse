# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# ── SQLite ────────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/music_rec.db

# ── hifi-api ──────────────────────────────────────────────────────────────────
HIFI_API_BASE_URL=https://api.hifi.example.com/v1
HIFI_API_KEY=your_hifi_api_key

# ── Spotify Web API ───────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── LastFM API ────────────────────────────────────────────────────────────────
LASTFM_API_KEY=your_lastfm_api_key

# ── MusicBrainz (no key required) ────────────────────────────────────────────
MUSICBRAINZ_APP=MusicRecEngine/1.0 (dev@example.com)

# ── Python embedding microservice ─────────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://localhost:8001
EMBEDDING_DIM=384

# ── Recommendation ────────────────────────────────────────────────────────────
QUEUE_SIZE=25
HOME_REC_COUNT=20
MIX_TRACK_COUNT=30
DIVERSITY_LAMBDA=0.3
NOVELTY_WEIGHT=0.2
POPULARITY_WEIGHT=0.1
RECENCY_DECAY_DAYS=30

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TRACK_TTL_MS=3600000       # 1h
CACHE_PROFILE_TTL_MS=300000      # 5m
CACHE_REC_TTL_MS=120000          # 2m
CACHE_MAX_ITEMS=5000

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_POLL_MS=500               # job queue poll interval
WORKER_CONCURRENCY=4             # parallel enrichment jobs
