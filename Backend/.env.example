# =============================================================================
# Muse Backend — environment variables
# =============================================================================
# Copy to `.env` and fill in real values where noted. Every variable below is
# read by Backend/src/config.ts. Values shown are the in-code defaults; you only
# need to set the ones marked REQUIRED or those you wish to override.
# =============================================================================

# ── Core / server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
LOG_LEVEL=info

# Fallback identity used (development only) when a request carries no Bearer
# token. In production, requests must present a valid token from /auth/login.
DEV_USER_ID=dev-user-001

# ── Auth / sessions ──────────────────────────────────────────────────────────
# HMAC secret for signing JWT session tokens. REQUIRED in any real deployment —
# the in-code default is insecure and public.
JWT_SECRET=muse-dev-insecure-secret-change-me
# Session token lifetime in seconds (default 30 days).
JWT_TTL_SEC=2592000

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Used by both the runtime PrismaClient (via the
# pg driver adapter) and the Prisma CLI (`prisma db push` / `prisma studio`).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muse

# ── External services ────────────────────────────────────────────────────────
# Base URL of the hifi-api FastAPI service (Tidal-compatible metadata/streaming
# proxy). Locally the service listens on port 8000; in docker-compose this is
# overridden to the service name (http://hifi-api:8000).
TIDAL_API_BASE_URL=http://localhost:8000

# Last.fm API key — REQUIRED for recommendations/enrichment. Placeholder value.
LASTFM_API_KEY=your_lastfm_api_key_here

# MusicBrainz User-Agent application string (per MB API etiquette).
MUSICBRAINZ_APP=MusicRecEngine/1.0

# ── Recommendation / mix sizing ──────────────────────────────────────────────
QUEUE_SIZE=25
HOME_REC_COUNT=20
MIX_TRACK_COUNT=30
RECENCY_DECAY_DAYS=30

# ── Caching (milliseconds) ───────────────────────────────────────────────────
CACHE_PROFILE_TTL_MS=300000
CACHE_REC_TTL_MS=120000

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_POLL_MS=500
WORKER_CONCURRENCY=4

# ── Job queue ────────────────────────────────────────────────────────────────
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SEC=60
JOB_LEASE_SEC=300
JOB_CLEANUP_INTERVAL_MS=3600000
LASTFM_CACHE_GRACE_DAYS=30
SHELF_IMPRESSION_RETENTION_DAYS=90

# ── Playback queue ───────────────────────────────────────────────────────────
QUEUE_LOW_WATER_MARK=5
SESSION_TTL_MS=10800000
PLAYED_IDS_HISTORY_CAP=200
HIGH_SIGNAL_COMPLETION_RATIO=0.8

# ── Recommender tuning ───────────────────────────────────────────────────────
SEED_TRACK_CAP=8
SEED_ARTIST_CAP=4
SIMILAR_PER_TRACK=30
MAX_TIDAL_LOOKUPS=44
TIDAL_RESOLVE_BATCH=5
PROFILE_MAX_GENRES=20
PROFILE_INTERACTION_LIMIT=5000

# ── Homepage builder ─────────────────────────────────────────────────────────
SECTION_ITEM_COUNT=10
COLLECTION_TRACK_COUNT=50
HOMEPAGE_FRESH_SEC=21600
TRACK_POOL_SIZE=180
