// Prisma schema for Muse. Models mirror the legacy better-sqlite3 schema
// 1:1 (snake_case table/column names preserved via @map/@@map) so existing
// data files and the analytical $queryRaw queries keep working unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String  @id
  externalId String  @unique @map("external_id")
  // Account fields. Optional so the legacy dev user and auto-provisioned
  // interaction users (which have no credentials) remain valid; the auth layer
  // enforces presence for real signups/logins.
  email        String? @unique
  passwordHash String? @map("password_hash")
  displayName  String? @map("display_name")
  isNew      Int     @default(1) @map("is_new")
  createdAt  Int     @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt  Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  interactions UserInteraction[]
  profile      UserProfile?
  settings     UserSetting?
  library      UserLibrary[]
  playlists    Playlist[]
  recommendations Recommendation[]
  searchHistory   SearchHistory[]

  @@map("users")
}

model UserSetting {
  userId           String  @id @map("user_id")
  streamingQuality String  @default("high") @map("streaming_quality")
  downloadQuality  String  @default("high") @map("download_quality")
  dataSaver        Int     @default(0) @map("data_saver")
  gaplessPlayback  Int     @default(1) @map("gapless_playback")
  automix          Int     @default(1)
  allowExplicit    Int     @default(1) @map("allow_explicit")
  updatedAt        Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

model Artist {
  id            String  @id
  name          String
  popularity    Float?
  pictureUrl    String? @map("picture_url")
  musicbrainzId String? @map("musicbrainz_id")
  genres        String?
  lastfmTags    String? @map("lastfm_tags")
  rawApiData    String? @map("raw_api_data")
  updatedAt     Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  tracks       Track[]
  interactions UserInteraction[]

  @@map("artists")
}

model Album {
  id            String  @id
  title         String
  coverUrl      String? @map("cover_url")
  vibrantColor  String? @map("vibrant_color")
  releaseDate   String? @map("release_date")
  musicbrainzId String? @map("musicbrainz_id")
  rawApiData    String? @map("raw_api_data")
  updatedAt     Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  tracks       Track[]
  interactions UserInteraction[]

  @@map("albums")
}

model Track {
  id           String  @id
  title        String
  duration     Int?
  bpm          Float?
  key          String?
  keyScale     String? @map("key_scale")
  popularity   Float?
  explicit     Int     @default(0)
  audioQuality String? @map("audio_quality")
  isrc         String?
  mixIds       String? @map("mix_ids")
  rawApiData   String? @map("raw_api_data")
  artistId     String? @map("artist_id")
  albumId      String? @map("album_id")
  createdAt    Int     @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt    Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  artist         Artist?           @relation(fields: [artistId], references: [id])
  album          Album?            @relation(fields: [albumId], references: [id])
  features       TrackFeatures?
  interactions   UserInteraction[]
  playlistTracks PlaylistTrack[]

  @@index([popularity], name: "tracks_popularity_idx")
  @@index([albumId], name: "tracks_album_idx")
  @@index([artistId], name: "tracks_artist_idx")
  @@map("tracks")
}

model TrackFeatures {
  trackId          String  @id @map("track_id")
  musicbrainzId    String? @map("musicbrainz_id")
  genre            String?
  subGenre         String? @map("sub_genre")
  moodTags         String? @map("mood_tags")
  lastfmPlayCount  Int?    @map("lastfm_play_count")
  enrichmentStatus String  @default("pending") @map("enrichment_status")
  enrichedAt       Int?    @map("enriched_at")
  errorMessage     String? @map("error_message")

  track Track @relation(fields: [trackId], references: [id])

  @@index([enrichmentStatus], name: "track_features_status_idx")
  @@index([genre], name: "tf_genre_idx")
  @@map("track_features")
}

model UserInteraction {
  id               Int     @id @default(autoincrement())
  userId           String  @map("user_id")
  trackId          String? @map("track_id")
  artistId         String? @map("artist_id")
  albumId          String? @map("album_id")
  eventType        String  @map("event_type")
  playDurationSec  Int?    @map("play_duration_sec")
  trackDurationSec Int?    @map("track_duration_sec")
  completionRatio  Float?  @map("completion_ratio")
  sessionId        String? @map("session_id")
  context          String?
  occurredAt       Int     @default(dbgenerated("(unixepoch())")) @map("occurred_at")

  user   User    @relation(fields: [userId], references: [id])
  track  Track?  @relation(fields: [trackId], references: [id])
  artist Artist? @relation(fields: [artistId], references: [id])
  album  Album?  @relation(fields: [albumId], references: [id])

  @@index([userId], name: "ui_user_idx")
  @@index([trackId], name: "ui_track_idx")
  @@index([occurredAt], name: "ui_occurred_idx")
  @@index([userId, eventType, occurredAt], name: "ui_user_event_time_idx")
  @@index([userId, artistId], name: "ui_user_artist_idx")
  @@map("user_interactions")
}

model UserProfile {
  userId             String  @id @map("user_id")
  preferredGenres    String? @map("preferred_genres")
  totalPlayCount     Int     @default(0) @map("total_play_count")
  uniqueTracksPlayed Int     @default(0) @map("unique_tracks_played")
  updatedAt          Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model SessionQueue {
  sessionId String @id @map("session_id")
  userId    String @map("user_id")
  queueJson String @map("queue_json")
  playedIds String @map("played_ids")
  expiresAt Int    @map("expires_at")
  updatedAt Int    @default(dbgenerated("(unixepoch())")) @map("updated_at")

  @@map("session_queues")
}

model Job {
  id          Int     @id @default(autoincrement())
  type        String
  payload     String
  status      String  @default("pending")
  attempts    Int     @default(0)
  maxAttempts Int     @default(3) @map("max_attempts")
  dedupKey    String? @map("dedup_key")
  scheduledAt Int     @default(dbgenerated("(unixepoch())")) @map("scheduled_at")
  startedAt   Int?    @map("started_at")
  leaseUntil  Int?    @map("lease_until")
  completedAt Int?    @map("completed_at")
  error       String?

  @@unique([type, dedupKey], name: "jobs_dedup_unique")
  @@index([status], name: "jobs_status_idx")
  @@index([type], name: "jobs_type_idx")
  @@map("jobs")
}

model Recommendation {
  id          Int     @id @default(autoincrement())
  userId      String  @map("user_id")
  surface     String
  tracksJson  String  @map("tracks_json")
  generatedAt Int     @default(dbgenerated("(unixepoch())")) @map("generated_at")
  expiresAt   Int?    @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, surface], name: "rec_user_surface_idx")
  @@map("recommendations")
}

model UserLibrary {
  id       Int    @id @default(autoincrement())
  userId   String @map("user_id")
  itemType String @map("item_type")
  itemId   String @map("item_id")
  addedAt  Int    @default(dbgenerated("(unixepoch())")) @map("added_at")
  isPinned Int    @default(0) @map("is_pinned")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, itemType, itemId], name: "user_library_unique")
  @@index([userId, itemType, itemId], name: "user_library_idx")
  @@index([userId, itemType], name: "user_library_user_type_idx")
  @@map("user_library")
}

model Playlist {
  id          String  @id
  userId      String  @map("user_id")
  title       String
  description String?
  coverUrl    String? @map("cover_url")
  createdAt   Int     @default(dbgenerated("(unixepoch())")) @map("created_at")
  updatedAt   Int     @default(dbgenerated("(unixepoch())")) @map("updated_at")

  user   User            @relation(fields: [userId], references: [id])
  tracks PlaylistTrack[]

  @@map("playlists")
}

model PlaylistTrack {
  id         Int    @id @default(autoincrement())
  playlistId String @map("playlist_id")
  trackId    String @map("track_id")
  position   Int
  addedAt    Int    @default(dbgenerated("(unixepoch())")) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playlistId, position], name: "playlist_track_idx")
  @@map("playlist_tracks")
}

model SearchHistory {
  id         Int     @id @default(autoincrement())
  userId     String  @map("user_id")
  query      String?
  itemType   String? @map("item_type")
  itemId     String? @map("item_id")
  imageUrl   String? @map("image_url")
  metadata   String?
  searchedAt Int     @default(dbgenerated("(unixepoch())")) @map("searched_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, searchedAt], name: "sh_user_time_idx")
  @@map("search_history")
}

model LastfmCache {
  cacheKey  String @id @map("cache_key")
  method    String
  response  String
  fetchedAt Int    @map("fetched_at")
  expiresAt Int    @map("expires_at")

  @@index([expiresAt], name: "lastfm_cache_expires_idx")
  @@map("lastfm_cache")
}

// Persistent Last.fm → Tidal resolution cache. Last.fm exposes no shared
// identifier with Tidal (only name + sometimes an MBID), so every cross-service
// lookup has to start from a text search. This table remembers the outcome of
// that search — keyed by entity type + a normalized lookup key — so repeat
// resolutions are free and, critically, *negative* results are cached too
// (tidalId = NULL means "confirmed not on Tidal", so we stop re-searching it).
// mbid/isrc are stored when known so a later async pass can upgrade a fuzzy
// match to an exact one without a schema change.
model ServiceMapping {
  entityType String  @map("entity_type") // "track" | "artist" | "album"
  lfKey      String  @map("lf_key") // normalized "artist|title" / "artist" / "artist|album"
  tidalId    String? @map("tidal_id") // NULL = confirmed no-match (negative cache)
  confidence Float   @default(0) // 0..1 final match score
  method     String  @default("fuzzy") // "exact" | "fuzzy" | "manual" | "negative"
  mbid       String?
  isrc       String?
  payload    String? // JSON snapshot of the resolved Tidal entity (zero-network cache hit)
  resolvedAt Int     @map("resolved_at")
  expiresAt  Int     @map("expires_at")

  @@id([entityType, lfKey])
  @@index([expiresAt], name: "service_mapping_expires_idx")
  @@map("service_mappings")
}

model HomepageCache {
  userId  String @id @map("user_id")
  shelves String
  builtAt Int    @map("built_at")

  @@map("homepage_cache")
}

model ShelfImpression {
  id       Int    @id @default(autoincrement())
  userId   String @map("user_id")
  itemType String @map("item_type")
  itemId   String @map("item_id")
  shownAt  Int    @default(dbgenerated("(unixepoch())")) @map("shown_at")

  @@index([userId, itemType, itemId, shownAt], name: "shelf_impressions_idx")
  @@map("shelf_impressions")
}
